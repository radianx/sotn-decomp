+   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+   THE SOFTWARE.
+
+   Incorporates some of the ideas from SABR shader. Thanks to Joshua Street.
+*/
+layout(location = 0) in vec2 uv;
+layout(location = 0) out vec4 FragColor;
+layout(set = 2, binding = 0) uniform sampler2D Source;
+layout(set = 3, binding = 0) uniform Params {
+    vec4 sourceRect;
+    vec4 gridOutput;
+    vec4 filterOptions;
+};
+
+vec3 Raw(vec2 coord) {
+    vec2 size = vec2(textureSize(Source, 0));
+    vec2 pixel = sourceRect.xy + coord * sourceRect.zw;
+    pixel = clamp(pixel, sourceRect.xy + 0.5,
+                  sourceRect.xy + sourceRect.zw - 0.5);
+    return texture(Source, pixel / size).rgb;
+}
+vec3 Pixel(vec2 pixel) {
+    pixel = clamp(pixel, vec2(0.0), gridOutput.xy - 1.0);
+    return Raw((pixel + 0.5) / gridOutput.xy);
+}
+vec3 Linear(vec2 p) {
+    vec2 base = floor(p - 0.5), part = fract(p - 0.5);
+    return mix(mix(Pixel(base), Pixel(base + vec2(1.0, 0.0)), part.x),
+               mix(Pixel(base + vec2(0.0, 1.0)), Pixel(base + vec2(1.0)), part.x),
+               part.y);
+}
+#define CORNER_C
+#define SMOOTH_TIPS
+#define XBR_Y_WEIGHT 48.0
+#define XBR_EQ_THRESHOLD 15.0
+#define XBR_LV1_COEFFICIENT 0.5
+#define XBR_LV2_COEFFICIENT 2.0
+#define lv2_cf XBR_LV2_COEFFICIENT
+#define small_details 0.0
+#define mul(a,b) (b*a)
+#define XBR_SCALE max(1.0, min(gridOutput.z / gridOutput.x, gridOutput.w / gridOutput.y))
+const float coef         = 2.0;
+const vec3 rgbw          = vec3(14.352, 28.176, 5.472);
+const vec4 eq_threshold  = vec4(15.0, 15.0, 15.0, 15.0);
+
+
+
+const  vec4 Ao = vec4( 1.0, -1.0, -1.0, 1.0 );
+const  vec4 Bo = vec4( 1.0,  1.0, -1.0,-1.0 );
+const  vec4 Co = vec4( 1.5,  0.5, -0.5, 0.5 );
+const  vec4 Ax = vec4( 1.0, -1.0, -1.0, 1.0 );
+const  vec4 Bx = vec4( 0.5,  2.0, -0.5,-2.0 );
+const  vec4 Cx = vec4( 1.0,  1.0, -0.5, 0.0 );
+const  vec4 Ay = vec4( 1.0, -1.0, -1.0, 1.0 );
+const  vec4 By = vec4( 2.0,  0.5, -2.0,-0.5 );
+const  vec4 Cy = vec4( 2.0,  0.0, -1.0, 0.5 );
+const  vec4 Ci = vec4(0.25, 0.25, 0.25, 0.25);
+
+const vec3 Y = vec3(0.2126, 0.7152, 0.0722);
+
+// Difference between vector components.
+vec4 df(vec4 A, vec4 B)
+{
+    return vec4(abs(A-B));
+}
+
+// Compare two vectors and return their components are different.
+vec4 diff(vec4 A, vec4 B)
+{
+    return vec4(notEqual(A, B));
+}
+
+// Determine if two vector components are equal based on a threshold.
+vec4 eq(vec4 A, vec4 B)
+{
+    return (step(df(A, B), vec4(XBR_EQ_THRESHOLD)));
+}
+
+// Determine if two vector components are NOT equal based on a threshold.
+vec4 neq(vec4 A, vec4 B)
+{
+    return (vec4(1.0, 1.0, 1.0, 1.0) - eq(A, B));
+}
+
+// Weighted distance.
+vec4 wd(vec4 a, vec4 b, vec4 c, vec4 d, vec4 e, vec4 f, vec4 g, vec4 h)
+{
+    return (df(a,b) + df(a,c) + df(d,e) + df(d,f) + 4.0*df(g,h));
+}
+
+vec4 weighted_distance(vec4 a, vec4 b, vec4 c, vec4 d, vec4 e, vec4 f, vec4 g, vec4 h, vec4 i, vec4 j, vec4 k, vec4 l)
+{
+	return (df(a,b) + df(a,c) + df(d,e) + df(d,f) + df(i,j) + df(k,l) + 2.0*df(g,h));
+}
+
+float c_df(vec3 c1, vec3 c2)
+{
+      vec3 df = abs(c1 - c2);
+      return df.r + df.g + df.b;
+}
+
+vec3 Xbr(vec2 p)
+{
+    vec4 edri, edr, edr_l, edr_u, px; // px = pixel, edr = edge detection rule
+    vec4 irlv0, irlv1, irlv2l, irlv2u, block_3d;
+    vec4 fx, fx_l, fx_u; // inequations of straight lines.
+
+    vec2 fp = fract(p);
+    vec4 delta = vec4(1.0 / XBR_SCALE);
+    vec4 delta_l = vec4(0.5, 1.0, 0.5, 1.0) / XBR_SCALE;
+    vec4 delta_u = delta_l.yxwz;
+
+    vec3 A1 = Pixel(floor(p) + vec2(-1.0, -2.0));
