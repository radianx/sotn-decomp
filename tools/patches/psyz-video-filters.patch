+    vec3 C1 = Pixel(floor(p) + vec2(1.0, -2.0));
+    vec3 A  = Pixel(floor(p) + vec2(-1.0, -1.0));
+    vec3 B  = Pixel(floor(p) + vec2(0.0, -1.0));
+    vec3 C  = Pixel(floor(p) + vec2(1.0, -1.0));
+    vec3 D  = Pixel(floor(p) + vec2(-1.0, 0.0));
+    vec3 E  = Pixel(floor(p) + vec2(0.0, 0.0));
+    vec3 F  = Pixel(floor(p) + vec2(1.0, 0.0));
+    vec3 G  = Pixel(floor(p) + vec2(-1.0, 1.0));
+    vec3 H  = Pixel(floor(p) + vec2(0.0, 1.0));
+    vec3 I  = Pixel(floor(p) + vec2(1.0, 1.0));
+    vec3 G5 = Pixel(floor(p) + vec2(-1.0, 2.0));
+    vec3 H5 = Pixel(floor(p) + vec2(0.0, 2.0));
+    vec3 I5 = Pixel(floor(p) + vec2(1.0, 2.0));
