+
+void main() {
+    vec2 p = uv * gridOutput.xy;
+    vec3 original = Raw(uv), color = original;
+    int mode = int(filterOptions.x);
+    if (mode == 1) color = Linear(p);
+    if (mode == 2) {
+        float row = floor(p.y);
+        float x = p.x - 0.5;
+        color = mix(Pixel(floor(p)),
+                    mix(Pixel(vec2(floor(x), row)),
+                        Pixel(vec2(floor(x) + 1.0, row)), fract(x)), 0.45);
+        float coverage = clamp(gridOutput.w / gridOutput.y - 1.0, 0.0, 1.0);
+        float beam = 1.0 - 0.20 * coverage * (0.5 + 0.5 * cos(p.y * 6.2831853));
+        vec3 mask = vec3(0.94);
+        mask[int(mod(floor(gl_FragCoord.x), 3.0))] = 1.06;
+        color *= beam * mask * 1.06;
+    }
+    if (mode == 3) color = Xbr(p);
+    FragColor = vec4(mix(original, clamp(color, 0.0, 1.0), filterOptions.y), 1.0);
+}
