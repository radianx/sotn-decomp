diff --git a/psyz/src/platform/present_gl.h b/psyz/src/platform/present_gl.h
new file mode 100644
--- /dev/null
+++ b/psyz/src/platform/present_gl.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MPL-2.0
+#include "shaders/present_vert_glsl.h"
+#include "shaders/present_frag_glsl.h"
+static GLuint present_program, present_vao;
+static GLint present_rect, present_grid, present_options;
+static bool present_failed;
+
+static void ResetPresentFilter(void) {
+    if (present_program)
+        glDeleteProgram(present_program);
+    if (present_vao)
+        glDeleteVertexArrays(1, &present_vao);
+    present_program = present_vao = 0;
+    present_failed = false;
+}
+
+static bool PresentFiltered(GLuint source, SDL_Rect src, SDL_Rect dst,
+                            int grid_w, int grid_h, int window_h) {
+    if (!video_filter || !filter_strength || debug_show_vram ||
+        present_failed || src.w <= 0 || src.h <= 0 || dst.w <= 0 || dst.h <= 0)
+        return false;
+    if (!present_program) {
+        GLuint vs = Init_CompileShader(present_vert_glsl, GL_VERTEX_SHADER);
+        GLuint fs = Init_CompileShader(present_frag_glsl, GL_FRAGMENT_SHADER);
+        GLuint program = glCreateProgram();
+        glAttachShader(program, vs);
+        glAttachShader(program, fs);
+        glLinkProgram(program);
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+        GLint ok;
+        glGetProgramiv(program, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            char log[1024];
+            glGetProgramInfoLog(program, sizeof(log), NULL, log);
+            WARNF("Video filter unavailable; using nearest: %s", log);
+            glDeleteProgram(program);
+            present_failed = true;
+            return false;
+        }
+        present_program = program;
+        glGenVertexArrays(1, &present_vao);
+        present_rect = glGetUniformLocation(program, "sourceRect");
+        present_grid = glGetUniformLocation(program, "gridOutput");
+        present_options = glGetUniformLocation(program, "filterOptions");
+        glUseProgram(program);
+        glUniform1i(glGetUniformLocation(program, "Source"), 0);
+    }
+    glUseProgram(present_program);
+    glBindVertexArray(present_vao);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    glViewport(dst.x, window_h - dst.y - dst.h, dst.w, dst.h);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, source);
+    glUniform4f(present_rect, src.x, src.y, src.w, src.h);
+    glUniform4f(present_grid, grid_w, grid_h, dst.w, dst.h);
+    glUniform4f(present_options, video_filter, filter_strength / 100.0f, 0, 0);
+    GLboolean blend = glIsEnabled(GL_BLEND);
+    glDisable(GL_BLEND);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    if (blend)
+        glEnable(GL_BLEND);
+    glBindVertexArray(0);
+    glUseProgram(shader_program);
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+    return true;
+}
