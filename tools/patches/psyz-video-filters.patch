diff --git a/psyz/src/platform/shaders/build_present_shaders.py b/psyz/src/platform/shaders/build_present_shaders.py
new file mode 100644
--- /dev/null
+++ b/psyz/src/platform/shaders/build_present_shaders.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Rebuild presentation shaders (glslangValidator, spirv-cross); --check verifies."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--check', action='store_true')
+args = parser.parse_args()
+root = Path(__file__).resolve().parent
+outputs = {}
+for stage in ('vert', 'frag'):
+    path = root / f'present.{stage}.glsl'
+    source = path.read_text()
+    name = f'present_{stage}'
+    banner = ('// Generated by build_present_shaders.py; SPDX-License-Identifier: MIT\n'
+              f'// Source SHA-256: {hashlib.sha256(path.read_bytes()).hexdigest()}\n')
+    with tempfile.TemporaryDirectory() as directory:
+        spv = Path(directory) / 'shader.spv'
+        subprocess.run(['glslangValidator', '-V', '--target-env', 'vulkan1.0',
+                        '-S', stage, str(path), '-o', str(spv)], check=True)
+        metal = subprocess.check_output(['spirv-cross', '--msl', str(spv)])
+        for suffix, data in [('spv', spv.read_bytes()), ('msl', metal)]:
+            rows = ['    ' + ', '.join(f'0x{x:02x}' for x in data[i:i+12]) + ','
+                    for i in range(0, len(data), 12)]
+            outputs[f'{name}_{suffix}.h'] = (banner +
+                f'_Alignas(4) static const unsigned char {name}_{suffix}[] = {{\n' +
+                '\n'.join(rows) + '\n};\n')
+    gl = source.replace('#version 450\n', '').replace('gl_VertexIndex', 'gl_VertexID')
+    gl = gl.replace('layout(set = 2, binding = 0) uniform sampler2D Source;',
+                    'uniform sampler2D Source;')
+    gl = gl.replace('layout(set = 3, binding = 0) uniform Params {\n'
+                    '    vec4 sourceRect;\n    vec4 gridOutput;\n'
+                    '    vec4 filterOptions;\n};',
+                    'uniform vec4 sourceRect, gridOutput, filterOptions;')
+    # GLSL 330 / ES 300 link varyings by name; explicit locations need 4.20.
+    gl = gl.replace('layout(location = 0) out vec2 uv;', 'out vec2 uv;')
+    gl = gl.replace('layout(location = 0) in vec2 uv;', 'in vec2 uv;')
+    assert 'layout(set' not in gl, 'OpenGL interface conversion failed'
+    outputs[f'{name}_glsl.h'] = (banner + f'static const char {name}_glsl[] =\n' +
+        '\n'.join('    ' + json.dumps(line + '\n') for line in gl.splitlines()) + ';\n')
+for name, content in outputs.items():
+    path = root / name
+    if args.check:
+        if not path.exists() or path.read_text() != content:
+            raise SystemExit(f'{name} is stale; rebuild presentation shaders')
+    else:
+        path.write_text(content)
+print('Presentation shader sources and generated headers: OK')
