+                : -1;
+    if (i < 0 || x < 0 || x >= VRAM_W || y < 0 || y >= VRAM_H ||
+        source.ex <= source.sx || source.ey <= source.sy ||
+        source.sx < layout.screen.sx || source.sy < layout.screen.sy ||
+        source.ex > layout.screen.ex || source.ey > layout.screen.ey) {
+        return -1;
+    }
+    int w = source.ex - source.sx, h = source.ey - source.sy;
+    if (w > VRAM_W - x || h > VRAM_H - y || !PrepareCanvas(&layout, i)) {
+        return -1;
+    }
+    SDL_Rect src = {source.sx - layout.screen.sx,
+                    source.sy - layout.screen.sy, w, h};
+    SDL_Rect dst = {x, y, w, h};
+    Blit(canvas_fbo[i], ScaleRect(src, (int)canvas_res), vram_fbo, dst);
+    if (HasSeparateDrawTarget()) {
+        Blit(canvas_fbo[i], ScaleRect(src, (int)canvas_res),
+             scaled_vram_fbo, ScaleRect(dst, (int)internal_res));
+    }
+    MarkRgb24Dirty(x, y, w, h);
+    for (int j = 0; j < fb_origin_count; j++) {
+        SDL_Rect fb = GetFbRect(j);
+        if (SDL_HasRectIntersection(&dst, &fb) && PrepareCanvas(&layout, j)) {
+            CopyVramToCanvas(j, dst);
+        }
+    }
+    return 0;
+}
