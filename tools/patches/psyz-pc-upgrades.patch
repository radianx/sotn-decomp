+static Uint64 paused_clock_total, paused_clock_start;
+static bool clock_paused;
+void Psyz_VideoPauseClock(int paused) {
+    Uint64 now = SDL_GetTicksNS();
+    if (paused && !clock_paused) {
+        paused_clock_start = now;
+    }
+    if (!paused && clock_paused) {
+        paused_clock_total += now - paused_clock_start;
+    }
+    clock_paused = paused != 0;
+}
+uint64_t Psyz_VideoClockNS(void) {
+    return (clock_paused ? paused_clock_start : SDL_GetTicksNS()) -
+           paused_clock_total;
+}
