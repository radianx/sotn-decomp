+bool Psyz_OverlayPresent_SDL3(SDL_Surface* surface) {
+    if (!device || !swapchain_ok || !surface ||
+        surface->format != SDL_PIXELFORMAT_RGBA32)
+        return false;
+    Draw_FlushBuffer();
+    SubmitCmd();
+    SDL_GPUTextureCreateInfo info = {
+        .type = SDL_GPU_TEXTURETYPE_2D,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width = surface->w,
+        .height = surface->h,
+        .layer_count_or_depth = 1,
+        .num_levels = 1,
+    };
+    SDL_GPUTexture* texture = SDL_CreateGPUTexture(device, &info);
+    SDL_GPUTransferBufferCreateInfo uploadInfo = {
+        .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+        .size = surface->pitch * surface->h,
+    };
+    SDL_GPUTransferBuffer* upload =
+        SDL_CreateGPUTransferBuffer(device, &uploadInfo);
+    bool ok = false;
+    if (!texture || !upload)
+        goto done;
+    void* pixels = SDL_MapGPUTransferBuffer(device, upload, false);
+    if (!pixels)
+        goto done;
+    memcpy(pixels, surface->pixels, uploadInfo.size);
+    SDL_UnmapGPUTransferBuffer(device, upload);
+    SDL_GPUCommandBuffer* cmd = SDL_AcquireGPUCommandBuffer(device);
+    if (!cmd)
+        goto done;
+    SDL_GPUTexture* target = NULL;
+    Uint32 w, h;
+    if (!SDL_WaitAndAcquireGPUSwapchainTexture(
+            cmd, sdl3_window, &target, &w, &h)) {
+        SDL_CancelGPUCommandBuffer(cmd);
+        goto done;
+    }
+    if (target) {
+        wnd_size_in_pixels = (WndSize){w, h};
+        SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+        SDL_GPUTextureTransferInfo source = {
+            .transfer_buffer = upload,
+            .pixels_per_row = surface->pitch / 4,
+            .rows_per_layer = surface->h,
+        };
+        SDL_GPUTextureRegion region = {
+            .texture = texture,
+            .w = surface->w,
+            .h = surface->h,
+            .d = 1,
+        };
+        SDL_UploadToGPUTexture(copy, &source, &region, false);
+        SDL_EndGPUCopyPass(copy);
+        PsyzRect fit = VideoLayout_Present(
+            (PsyzSize){w, h}, (PsyzSize){surface->w, surface->h},
+            (PsyzSize){surface->w, surface->h});
+        SDL_GPUBlitInfo blit = {
+            .source = {.texture = texture, .w = surface->w, .h = surface->h},
+            .destination = {.texture = target,
+                            .x = fit.sx,
+                            .y = fit.sy,
+                            .w = (fit.ex - fit.sx),
+                            .h = (fit.ey - fit.sy)},
+            .load_op = SDL_GPU_LOADOP_CLEAR,
+            .clear_color = {0, 0, 0, 1},
+            .filter = SDL_GPU_FILTER_NEAREST,
+        };
+        SDL_BlitGPUTexture(cmd, &blit);
+    }
+    ok = SDL_SubmitGPUCommandBuffer(cmd);
+done:
+    if (upload)
+        SDL_ReleaseGPUTransferBuffer(device, upload);
+    if (texture)
+        SDL_ReleaseGPUTexture(device, texture);
+    return ok;
 }

